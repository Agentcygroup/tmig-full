#!/usr/bin/env bash
set -uo pipefail

# Resolve this script's real path even if invoked via symlink.
SELF="$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"
cd "$ROOT" || { echo "cannot cd to $ROOT"; exit 1; }

cmd="${1:-status}"; shift || true

case "$cmd" in
  status)
    printf '\n  HEAD:  %s\n' "$(git log --oneline -1 2>/dev/null || echo 'not a git repo')"
    printf '  root:  %s\n' "$ROOT"
    printf '  hooks: %s\n' "$(git config core.hooksPath 2>/dev/null || echo unset)"
    printf '  tag:   %s\n' "$(git tag --list 2>/dev/null | tr '\n' ' ')"
    printf '  disk:  %s free\n' "$(df -h "$ROOT" | tail -1 | awk '{print $4}')"
    ;;
  verify)          bash scripts/local-verify.sh ;;
  doctor)          bash dxp/doctor.sh ;;
  license)         bash licensing/check.sh ;;
  health)          bash lifecycle/healthcheck.sh ;;
  probe)           bash ix/probe.sh ;;
  infra-status)    bash infra/status.sh ;;
  infra-reconcile) bash infra/bin/reconcile ;;
  policy)          bash policy/check.sh ;;
  release)         bash ci/release.sh "$@" ;;
  ui-web)          python3 ui/web/server.py ;;
  *) echo "unknown: $cmd" >&2; exit 1 ;;
esac
