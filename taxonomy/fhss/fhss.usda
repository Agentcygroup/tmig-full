    def "Schemes"
    {
        def Xform "Bluetooth_Classic_FHSS"
        {
            custom string class = "slow"
            custom string hops_per_bit = "1"
            custom string name = "Bluetooth Classic FHSS"
            custom string pattern = "79 channels × 1 MHz BT clock"
            custom string use_case = "consumer wireless"
        }

        def Xform "Bluetooth_LE_Adaptive_FH"
        {
            custom string class = "slow"
            custom string hops_per_bit = "1"
            custom string name = "Bluetooth LE Adaptive FH"
            custom string pattern = "37 channels, channel map update"
            custom string use_case = "BLE"
