#!/usr/bin/env bash
set -uo pipefail
RUNT="$HOME/tmig-full/taxonomy/runtime"
PY="$HOME/tmig-full/venvs/hf/bin/python"
cmd="${1:-}"; shift || true
case "$cmd" in
  resolve)  exec "$PY" "$RUNT/resolve.py" "$@" ;;
  memory)   exec "$PY" "$RUNT/memory.py" "$@" ;;
  router)   exec "$PY" "$RUNT/router.py" "$@" ;;
  receipts) exec "$PY" "$RUNT/receipt.py" "$@" ;;
  eval)     exec "$PY" "$RUNT/eval.py" "$@" ;;
  run)
    text="$*"
    plan=$("$PY" "$RUNT/resolve.py" "$text")
    task=$(echo "$plan" | "$PY" -c "import sys,json; print(json.load(sys.stdin)['tasks'][0])")
    runtime=$("$PY" "$RUNT/router.py" "$task")
    prim=$(echo "$plan" | "$PY" -c "import sys,json; p=json.load(sys.stdin)['prims']; print(p[0]['path'] if p else '')")
    "$PY" "$RUNT/receipt.py" append "{\"event\":\"run\",\"intent\":\"$text\",\"task\":\"$task\",\"runtime\":\"$runtime\",\"prim\":\"$prim\"}"
    echo "intent:   $text"
    echo "task:     $task"
    echo "runtime:  $runtime"
    echo "prim:     $prim"
    echo; echo "$plan"
    ;;
  status)
    echo "== sovereign runtime =="
    "$PY" "$RUNT/router.py" status
    echo; "$PY" "$RUNT/receipt.py"
    echo; "$PY" "$RUNT/memory.py"
    ;;
  *)
    cat <<EOF
sovereign — intelligence utility

usage:
  sovereign resolve "<intent>"
  sovereign run "<intent>"
  sovereign memory index
  sovereign memory <query>
  sovereign router status
  sovereign receipts verify
  sovereign eval [task ...]
  sovereign status
EOF
    ;;
esac
